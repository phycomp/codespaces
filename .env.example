# Rakazo Codespaces Environment
# Copy this to rakazo/.env and fill in your values

# === Model Provider (choose one or more) ===
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# === OpenCode Go (OpenAI-compatible) ===
# Get your API key from: https://opencode.ai/console
# OpenCode Go provides an OpenAI-compatible API endpoint.
# OPENCODE_GO_API_KEY=oc_sk_...
# OPENCODE_GO_BASE_URL=https://opencode.ai/inference/openai/v1
# OPENCODE_GO_MODEL=deepseek-v4.1-flash

# === Sandbox Provider ===
# In Codespaces, Docker (DinD) is used by default
SANDBOX_PROVIDER=docker

# === Secrets (auto-generated by setup script) ===
# BETTER_AUTH_SECRET=
# ENCRYPTION_KEY=
# SCREEN_PROXY_SECRET=
# SANDBOX_SUPERVISOR_TOKEN=

# === Codespaces URLs (auto-set by setup script) ===
# BETTER_AUTH_URL=https://<codespace>-5173.app.github.dev
# WEB_ORIGIN=https://<codespace>-5173.app.github.dev
# API_URL=https://<codespace>-5173.app.github.dev
# RAKAZO_HOST=<codespace>-5173.app.github.dev

# === Resource Limits ===
RAKAZO_COMPUTER_MEMORY=2g
RAKAZO_COMPUTER_CPUS=2
SANDBOX_IDLE_MS=0
